# Pinned upstream inputs. Every value here is verified at install time.
# shellcheck shell=bash

QE_VERSION=7.6

# The annotated tag qe-7.6 dereferences to this commit. Git object IDs are
# content-addressed, so this is the authoritative pin. The tarball checksum
# below is only a faster path to the same bytes.
QE_GIT_REPO=https://gitlab.com/QEF/q-e.git
QE_GIT_TAG=qe-7.6
QE_COMMIT=9f93ddec427d2b9a45bb72d828c6d324f62fcabd

# Both mirrors are git-archive endpoints and served byte-identical output when
# this was pinned (87688909 bytes each). They regenerate archives on demand, so
# a checksum mismatch here means "fall back to git", not "abort".
QE_TARBALL=q-e-qe-7.6.tar.gz
QE_TARBALL_SHA256=945c8f16ab330c8f0b30f4de1a9a088b85038476fcd819394e641f4d2d8b7d51
QE_TARBALL_URLS=(
  "https://gitlab.com/QEF/q-e/-/archive/qe-7.6/q-e-qe-7.6.tar.gz"
  "https://github.com/QEF/q-e/archive/refs/tags/qe-7.6.tar.gz"
)

# Toolchain module. Pinned to an exact version because the site default moves:
# intel/2024_01_46 currently carries ifx 2024.0.2, Intel MPI 2021.11, MKL 2024.0.
TOOLCHAIN_MODULE=intel/2024_01_46

# MKL supplies BLAS, LAPACK, ScaLAPACK and FFT (via DFTI), so there are no
# dependencies to build from source. If configure fails to find MKL it silently
# falls back to QE's bundled reference LAPACK, which builds fine and runs an
# order of magnitude slower -- so we assert on these tokens instead of trusting it.
QE_EXPECTED_DFLAGS="-D__DFTI -D__MPI -D__SCALAPACK"
