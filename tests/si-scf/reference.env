# Expected result of tests/si-scf, measured on Forerunner 1 with the pinned
# toolchain. conv_thr is 1e-8 Ry, so the tolerance below is loose enough to be
# insensitive to the MPI rank count but tight enough to catch a broken build
# (a wrong FFT or LAPACK path shifts this by far more than 1e-6 Ry).
# shellcheck shell=bash

QE_TEST_ENERGY_RY=-15.83812818
QE_TEST_TOLERANCE_RY=1e-6
QE_TEST_RANKS=2
QE_TEST_PSEUDO=Si.pz-vbc.UPF
QE_TEST_PSEUDO_SHA256=e8d933754cd51c6bb4b2a809151f89e0647e53d878bab88d26e1b5a5d68d5217
